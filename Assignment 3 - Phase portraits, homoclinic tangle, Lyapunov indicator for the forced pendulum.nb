Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["3. ",
  FontWeight->"Bold"],
 "Investigation on Lyapunov indicator"
}], "Subsection",
 CellChangeTimes->{{3.9355929640252743`*^9, 3.9355929740546055`*^9}, {
  3.935766823058058*^9, 
  3.935766833613245*^9}},ExpressionUUID->"cf6eeb62-b8bb-ed45-9a1f-\
2ecc396a014f"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"To", " ", "calculate", " ", "Lyapunov", " ", "indicator"}], ",", 
   " ", 
   RowBox[{
   "we", " ", "need", " ", "to", " ", "consider", " ", "its", " ", "tangent", 
    " ", 
    RowBox[{"lift", ".", " ", "First"}], " ", "calculate", " ", "the", " ", 
    "Jacobian", " ", "matrix", " ", "of", " ", 
    RowBox[{"X", ":"}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9357568443616047`*^9, 3.9357568565508156`*^9}, {
  3.935757084461218*^9, 3.9357570935434933`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"392bb7f7-65d5-4842-b6e4-b9fcc730bb2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"JacX", "=", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"X", "[", "k", "]"}], "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", "v", ",", "t"}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"x", ",", "v", ",", "t"}], "}"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.935756870101782*^9, 3.935756872622757*^9}, {
   3.9357569266002426`*^9, 3.9357569686484394`*^9}, 3.9357674297820473`*^9},
 CellLabel->"In[71]:=",ExpressionUUID->"5abf1cc5-4547-694e-b369-9d1035f85957"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"JX", "[", "k_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "v_", ",", "t_"}], "}"}], "]"}], "=", "JacX"}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.935756990966343*^9, 3.935757026222397*^9}},
 CellLabel->"In[72]:=",ExpressionUUID->"ed103f57-bf0b-3849-8c1f-7915c40d85b9"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "Then", " ", "the", " ", "tangent", " ", "dynamics", " ", "with", " ", 
    "parameter", " ", "k"}], ",", " ", 
   RowBox[{"u", " ", "being", " ", "the", " ", "tangent", " ", "vector"}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.9357570789864025`*^9, 3.9357571319163456`*^9}, {
  3.935757229813637*^9, 3.935757272903015*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"23e55d05-3b96-6b40-b080-2bf7b40477a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"TGX", "[", "k_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"xvt_", ",", "u_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"X", "[", "k", "]"}], "[", "xvt", "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"JX", "[", "k", "]"}], "[", "xvt", "]"}], ".", "u"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9357571156860924`*^9, 3.935757127123354*^9}, {
  3.935757210372137*^9, 3.9357572246485176`*^9}, {3.935757281174185*^9, 
  3.935757298962696*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"dcef1bce-07e4-3341-8fe4-6f0d8e87e863"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TgAlgo", "[", 
    RowBox[{"k_", ",", "h_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"xvt_", ",", "u_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"xvt", ",", "u"}], "}"}], "+", 
   RowBox[{"h", " ", 
    RowBox[{
     RowBox[{"TGX", "[", "k", "]"}], "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xvt", ",", "u"}], "}"}], "+", 
      RowBox[{
       FractionBox["h", "2"], 
       RowBox[{
        RowBox[{"TGX", "[", "k", "]"}], "[", 
        RowBox[{"{", 
         RowBox[{"xvt", ",", "u"}], "}"}], "]"}]}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.935757339535166*^9, 3.9357574359926777`*^9}, {
  3.935757590710655*^9, 3.9357576104826584`*^9}, {3.9357576419843388`*^9, 
