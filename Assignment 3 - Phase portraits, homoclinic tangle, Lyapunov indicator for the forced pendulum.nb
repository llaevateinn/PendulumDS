Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["2.",
  FontWeight->"Bold"],
 " Stable and unstable manifolds (homoclinic tangles)"
}], "Subsection",
 CellChangeTimes->{{3.9355674337439384`*^9, 3.9355674529467964`*^9}, {
  3.9355834186710873`*^9, 3.935583418857643*^9}, {3.935592932452736*^9, 
  3.935592940601967*^9}},ExpressionUUID->"ba807254-aee9-ac46-b3aa-\
5b84263244f6"],

Cell["\<\
We use the Lambda lemma to find the unstable and stable manifolds. 
Here, for example, I take k=0.05, 0.3, 0.7 respectively. 
First, estimate the fixed point by plotting ||Subscript[\[CapitalPsi], \
k](x,0)-(x,0)||, which is close to (\[Pi],0). \
\>", "Text",
 CellChangeTimes->{{3.935569006926056*^9, 3.935569024600094*^9}, {
  3.9355696707324696`*^9, 3.935569679743292*^9}, {3.935570172971834*^9, 
  3.9355702062965965`*^9}, {3.9355829385681286`*^9, 3.935583000621067*^9}, {
  3.9355892091628647`*^9, 3.9355892097520485`*^9}, {3.9355894731779423`*^9, 
  3.935589487163059*^9}, {3.935589768044449*^9, 3.935589769296362*^9}, {
  3.935589831709837*^9, 3.93558990269536*^9}, {3.93559003922176*^9, 
  3.935590057160204*^9}, {3.9355908905557976`*^9, 
  3.9355908923572083`*^9}},ExpressionUUID->"8d42dbda-f6e9-684d-9a38-\
0b857694501e"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["2.1",
  FontWeight->"Bold"],
 " k = 0.05"
}], "Subsubsection",
 CellChangeTimes->{{3.9355909437907925`*^9, 
  3.9355909513480663`*^9}},ExpressionUUID->"5d1ec3de-be60-fe41-8fcf-\
8871da430209"],

