Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "Lyapunov", " ", "indicator", " ", "is", " ", "calculated", 
    " ", 
    RowBox[{"as", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LCE", "[", 
     RowBox[{"k_", ",", "h_", ",", "nit_"}], "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"xvt_", ",", "u_"}], "}"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"Drop", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"Map", "[", 
        RowBox[{"Norm", ",", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"TgOrb", "[", 
             RowBox[{"k", ",", "h", ",", "nit"}], "]"}], "[", 
            RowBox[{"{", 
             RowBox[{"xvt", ",", "u"}], "}"}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], ",", "1"}], "]"}], 
    RowBox[{".01", " ", 
     RowBox[{"Range", "[", "nit", "]"}]}]]}]}]], "Input",
 CellChangeTimes->{{3.935760963705942*^9, 3.93576102574432*^9}, {
  3.9357612122729206`*^9, 3.9357612293709354`*^9}, {3.9357612823822327`*^9, 
