Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TgOrb", "[", 
    RowBox[{"k_", ",", "h_", ",", "nit_"}], "]"}], "[", 
   RowBox[{"{", 
    RowBox[{"xvt_", ",", "u_"}], "}"}], "]"}], ":=", 
  RowBox[{"NestList", "[", 
   RowBox[{
    RowBox[{"TgAlgo", "[", 
     RowBox[{"k", ",", "h"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"xvt", ",", "u"}], "}"}], ",", "nit"}], "]"}]}]], "Input",
