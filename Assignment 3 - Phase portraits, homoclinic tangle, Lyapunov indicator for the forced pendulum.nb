Cell[TextData[{
 StyleBox["3. ",
  FontWeight->"Bold"],
 "Phase portraits, stable and unstable manifolds (\"homoclinic tangle\") and \
Lyapunov indicator for the forced pendulum \n                x'' + sin (x) = \
k cos (t) \n      and their dependence on the parameter k >= 0."
}], "Text",
 CellChangeTimes->{{3.9622750531587677`*^9, 
  3.9622750558536835`*^9}},ExpressionUUID->"ad1db933-c0a4-cd4c-81f5-\
92eb528befae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Similar", " ", "to", " ", "former", " ", "cases"}], ",", " ", 
    RowBox[{
     RowBox[{"use", " ", "Runge"}], "-", 
     RowBox[{
     "Kutta", " ", "to", " ", "find", " ", "the", " ", "period", " ", 
      "shifting", " ", "map", 
      RowBox[{"(", "PSM", ")"}], " ", "of", " ", "the", " ", "vector", " ", 
      RowBox[{"field", ":"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"X", "[", "k_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "v_", ",", "t_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"v", ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"Sin", "[", "x", "]"}]}], "+", 
      RowBox[{"k", " ", 
