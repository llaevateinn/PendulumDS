Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "It", " ", "seems", " ", "no", " ", "feature", " ", "can", " ", "be", " ", 
    "deduced", " ", "from", " ", "the", " ", 
    RowBox[{"picture", ".", " ", "To"}], " ", "have", " ", "a", " ", "better",
     " ", "look"}], ",", " ", 
   RowBox[{
   "I", " ", "try", " ", "to", " ", "approximate", " ", "LCE", " ", "by", " ",
     "average", " ", "of", " ", "points", " ", "of", " ", "the", " ", "last", 
    " ", "quater"}], ",", " ", 
   RowBox[{"with", " ", "fixed", " ", "time", " ", "of", " ", "iteration"}], 
   ",", " ", "stepsize", ",", " ", 
   RowBox[{
    RowBox[{"with", " ", "k", " ", 
     RowBox[{"in", " ", "[", 
      RowBox[{"0.05", ",", "10"}], "]"}]}], ":"}]}], " ", "*)"}]], "Input",
